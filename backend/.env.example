# Copy to .env and fill in real values. Never commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/wifirent_bd
DB_USERNAME=wifirent
DB_PASSWORD=changeme

JWT_SECRET=change-me-in-production-at-least-32-random-chars

CORS_ALLOWED_ORIGINS=http://localhost:*

# Gateway mock settings (development only)
GATEWAY_MODE=mock

# Scheduler delay in milliseconds for session expiration
SCHEDULER_EXPIRATION_DELAY_MS=60000

# Demo wallet configuration (virtual credits only, no real money)
WALLET_INITIAL_DEMO_BALANCE=5000
WALLET_PLATFORM_COMMISSION_RATE_BPS=100
